index 0000000000..0c6fb9bf56
--- /dev/null
+++ w/compiler/rustc_data_structures/src/flock/wasi.rs
@@ -0,0 +1,23 @@
+//! WASI has no file locks. A compiler built for it runs as the only process on its file system
+//! (each build gets its own instance), so a lock that always succeeds is enough for incremental
+//! compilation's session directories.
+
+use std::fs::{File, OpenOptions};
+use std::io;
+use std::path::Path;
+
+#[derive(Debug)]
+pub struct Lock {
+    _file: File,
+}
+
+impl Lock {
+    pub fn new(p: &Path, _wait: bool, create: bool, _exclusive: bool) -> io::Result<Lock> {
+        let file = OpenOptions::new().read(true).write(true).create(create).open(p)?;
+        Ok(Lock { _file: file })
+    }
+
+    pub fn error_unsupported(_err: &io::Error) -> bool {
+        false
+    }
+}
