+/// Runs lld linked into this compiler (`LLVMRustRunLld` in rustc_llvm's `LLD.cpp`) with the
+/// arguments the linker process would have got.
+#[cfg(target_os = "wasi")]
+fn run_lld_in_process(sess: &Session, cmd: &Command) -> io::Result<Output> {
+    use std::ffi::{CString, c_char, c_int, c_void};
+
+    unsafe extern "C" {
+        fn LLVMRustRunLld(
+            argc: c_int,
+            argv: *const *const c_char,
+            write: extern "C" fn(*mut c_void, c_int, *const u8, usize),
+            ctx: *mut c_void,
+        ) -> c_int;
+    }
+
+    extern "C" fn write(ctx: *mut c_void, stream: c_int, ptr: *const u8, len: usize) {
+        // SAFETY: `ctx` is the `(stdout, stderr)` below, `ptr..ptr + len` lld's output.
+        let (stdout, stderr) = unsafe { &mut *(ctx as *mut (Vec<u8>, Vec<u8>)) };
+        let bytes = unsafe { std::slice::from_raw_parts(ptr, len) };
+        if stream == 1 { stdout } else { stderr }.extend_from_slice(bytes);
+    }
+
+    let command = cmd.command();
+    let args = std::iter::once(command.get_program())
+        .chain(command.get_args())
+        .map(|arg| CString::new(arg.as_encoded_bytes()).map_err(io::Error::other))
+        .collect::<io::Result<Vec<_>>>()?;
+    let argv = args.iter().map(|arg| arg.as_ptr()).collect::<Vec<_>>();
+    let mut output = (Vec::new(), Vec::new());
+    let ret = unsafe {
+        LLVMRustRunLld(
+            argv.len() as c_int,
+            argv.as_ptr(),
+            write,
+            &mut output as *mut (Vec<u8>, Vec<u8>) as *mut c_void,
+        )
+    };
+    let (stdout, stderr) = output;
+    if ret != 0 {
+        let mut message = String::from_utf8_lossy(&stderr).into_owned();
+        message.push_str(&String::from_utf8_lossy(&stdout));
+        sess.dcx().fatal(format!("linking with lld (in-process) failed: exit code {ret}\n{message}"));
+    }
+    Ok(Output { status: Default::default(), stdout, stderr })
+}
+
 fn exec_linker(
