index 0000000000..941cea40c1
--- /dev/null
+++ w/compiler/rustc_static_proc_macros/serde_derive/src/this.rs
@@ -0,0 +1,32 @@
+use crate::internals::ast::Container;
+use syn::{Path, PathArguments, Token};
+
+pub fn this_type(cont: &Container) -> Path {
+    if let Some(remote) = cont.attrs.remote() {
+        let mut this = remote.clone();
+        for segment in &mut this.segments {
+            if let PathArguments::AngleBracketed(arguments) = &mut segment.arguments {
+                arguments.colon2_token = None;
+            }
+        }
+        this
+    } else {
+        Path::from(cont.ident.clone())
+    }
+}
+
+pub fn this_value(cont: &Container) -> Path {
+    if let Some(remote) = cont.attrs.remote() {
+        let mut this = remote.clone();
+        for segment in &mut this.segments {
+            if let PathArguments::AngleBracketed(arguments) = &mut segment.arguments {
+                if arguments.colon2_token.is_none() {
+                    arguments.colon2_token = Some(Token![::](arguments.lt_token.span));
+                }
+            }
+        }
+        this
+    } else {
+        Path::from(cont.ident.clone())
+    }
+}
diff --git c/compiler/rustc_static_proc_macros/src/lib.rs w/compiler/rustc_static_proc_macros/src/lib.rs
new file mode 100644
index 0000000000..8082bc157b
--- /dev/null
+++ w/compiler/rustc_static_proc_macros/src/lib.rs
@@ -0,0 +1,45 @@
+//! Proc macros linked into a compiler that cannot load proc macro dylibs (one built for WASI).
+//!
+//! A proc macro crate's dylib holds a `#[rustc_proc_macro_decls]` static: one bridge client per macro,
+//! in the order the crate defines them, which its metadata refers to by index. This crate builds the
+//! same tables from the macros' functions; `rustc_metadata::STATIC_PROC_MACROS` looks them up by
+//! crate name. The proc macro crate's dylib, built natively, is still read for its metadata.
+//!
+//! rustc loads every proc macro crate in the dependency graph, also those only the dependencies use.
+//! Crates that aren't linked in get stand-ins, which make a compile error only if a macro is used.
+
+#![feature(proc_macro_internals)]
+
+extern crate proc_macro;
+
+use proc_macro::TokenStream;
+use proc_macro::bridge::client::Client;
+
+/// serde_derive: `Serialize`, then `Deserialize`.
+static SERDE_DERIVE: [Client; 2] = [
+    Client::expand1(serde_derive::derive_serialize),
+    Client::expand1(serde_derive::derive_deserialize),
+];
+
+/// A macro of a crate that isn't linked in. It must not panic: this compiler is built with
+/// `panic=abort`, so a panic would end the compilation instead of becoming an error.
+fn not_linked_in(_input: TokenStream) -> TokenStream {
+    "::core::compile_error! { \"this proc macro isn't linked into this compiler (built for WebAssembly, it \
+     can't load proc macro libraries): add its crate to rustc_static_proc_macros\" }"
+        .parse()
+        .unwrap_or_default()
+}
+
+const NOT_LINKED_IN: Client = Client::expand1(not_linked_in);
+
+/// Enough stand-ins for any crate's macros.
+static NOT_LINKED_IN_TABLE: [Client; 512] = [NOT_LINKED_IN; 512];
+
+/// The proc macros of the crate called `name`: a pointer to the clients and their count.
+pub fn lookup(name: &str) -> Option<(*const (), usize)> {
+    let clients: &'static [Client] = match name {
+        "serde_derive" => &SERDE_DERIVE,
+        _ => &NOT_LINKED_IN_TABLE,
+    };
+    Some((clients.as_ptr() as *const (), clients.len()))
+}
