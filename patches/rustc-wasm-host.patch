+
+/// Proc macros linked into a compiler that cannot load dylibs, such as one built for WebAssembly.
+///
+/// The compiler's `main` sets this to a function that returns the proc macros of a crate by its name,
+/// in the order of the crate's `#[rustc_proc_macro_decls]` static: a pointer to them (each a
+/// `proc_macro::bridge::client::Client`, the same layout as `ProcMacroClient`) and their count.
+/// The proc macro crate's dylib is still read, for its metadata only.
+pub static STATIC_PROC_MACROS: std::sync::OnceLock<fn(&str) -> Option<(*const (), usize)>> =
+    std::sync::OnceLock::new();
+
+#[cfg(target_family = "wasm")]
+pub unsafe fn load_symbol_from_dylib<T: Copy>(
+    path: &Path,
+    _sym_name: &str,
+) -> Result<T, DylibError> {
+    Err(DylibError::DlOpen(
+        path.display().to_string(),
+        "dynamic libraries cannot be loaded by a compiler built for WebAssembly".to_owned(),
+    ))
+}
+
+#[cfg(target_family = "wasm")]
+pub(crate) fn dlsym_proc_macros(
+    path: &Path,
+    _stable_crate_id: StableCrateId,
+) -> Result<&'static [ProcMacroClient], DylibError> {
+    // `libserde_derive-1a2b3c.so` (or `.wasm`) holds the proc macros of `serde_derive`.
+    let file = path.file_stem().and_then(|stem| stem.to_str()).unwrap_or("");
+    let file = file.strip_prefix("lib").unwrap_or(file);
+    let name = file.rsplit_once('-').map_or(file, |(name, _hash)| name);
+    debug!("looking up the linked-in proc macros of `{name}` for {}", path.display());
+    match STATIC_PROC_MACROS.get().and_then(|lookup| lookup(name)) {
+        // SAFETY: the lookup returns `count` clients of the same layout as `ProcMacroClient`.
+        Some((clients, count)) => {
+            Ok(unsafe { std::slice::from_raw_parts(clients as *const ProcMacroClient, count) })
+        }
+        None => Err(DylibError::DlOpen(
+            path.display().to_string(),
+            format!(
+                "the proc macros of `{name}` are not linked into this compiler, \
+                 which cannot load dynamic libraries"
+            ),
+        )),
+    }
+}
