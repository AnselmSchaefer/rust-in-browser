+    // A compiler for WASI: LLVM is built with threads, and with WASI's emulation of `mmap` (for
+    // calls that are unreachable there). lld is linked in, since WASI can't spawn it.
+    let is_wasi = target.contains("wasi");
+    if is_wasi {
+        // cc names the target `wasm32-wasi`, for which wasi-sdk has no C++ headers; the last one wins.
+        cfg.flag(format!("--target={target}"));
+        cfg.flag("-pthread").flag("-D_WASI_EMULATED_MMAN").flag("-D_WASI_EMULATED_SIGNAL");
