--- /dev/null
+++ w/compiler/rustc_llvm/llvm-wrapper/LLD.cpp
@@ -0,0 +1,24 @@
+// lld, linked into a compiler that cannot spawn the linker as a process (one built for WASI).
+// `run_lld_in_process` in rustc_codegen_ssa calls this with the linker's command line.
+
+#include "lld/Common/Driver.h"
+#include "llvm/Support/raw_ostream.h"
+
+#include <string>
+
+LLD_HAS_DRIVER(wasm)
+
+extern "C" int LLVMRustRunLld(int Argc, const char **Argv,
+                              void (*Write)(void *, int, const char *, size_t),
+                              void *Ctx) {
+  std::string Out, Err;
+  llvm::raw_string_ostream OutStream(Out), ErrStream(Err);
+  llvm::ArrayRef<const char *> Args(Argv, Argv + Argc);
+  lld::Result R =
+      lld::lldMain(Args, OutStream, ErrStream, {{lld::Wasm, &lld::wasm::link}});
+  OutStream.flush();
+  ErrStream.flush();
+  Write(Ctx, 1, Out.data(), Out.size());
+  Write(Ctx, 2, Err.data(), Err.size());
+  return R.retCode;
+}
